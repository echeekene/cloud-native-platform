# Listens on 1053 inside the container so CoreDNS can run as a non root
# user with no extra capabilities. The Service maps port 53 to it.

# Internal zone served from a zone file
platform.internal:1053 {
    file /etc/coredns/zones/db.platform.internal
    log
    errors
    prometheus :9153
}

# Everything else is cached and forwarded upstream over TLS
.:1053 {
    errors
    log . {
        class denial error
    }
    health :8080 {
        lameduck 5s
    }
    ready :8181
    prometheus :9153
    cache 300 {
        denial 1024 30
    }
    forward . tls://1.1.1.1 tls://1.0.0.1 {
        tls_servername cloudflare-dns.com
        health_check 10s
        max_concurrent 1000
    }
    loop
    reload 30s
    loadbalance
}
